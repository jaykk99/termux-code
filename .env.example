# Error Inbox — its real /api/models feed and /api/v1/message agent endpoint.
# ERROR_INBOX_KEY is optional for /api/models (that route reads open in
# current source) but required for /ask (an eibx_... token from its
# Settings page — Settings → API keys).
ERROR_INBOX_URL=https://error-inbox.vercel.app
ERROR_INBOX_KEY=

# --- Provider keys, matching error-inbox's own env var names exactly, so an ---
# --- existing .env can be copied over verbatim. Every provider below is off ---
# --- until its key is set. Three need no key at all: Kilo, LLM7, AI Horde.  ---

# Hugging Face — the hosted agent's default model is Jay's first
# uncensored pick from his Inbox Models pool, served keyless through
# error-inbox's HF catalog route; HF_MODEL swaps it by env alone.
# HF_TOKEN (below) only upgrades the quota.
HF_MODEL=

# Composio — the owner's connected apps (Gmail, Calendar, Facebook, ...)
# for the hosted agent's composio_search / composio_execute tools. Server
# env only, never sent to the browser.
COMPOSIO_API_KEY=

# --- Hosted app (GitHub sign-in) ---------------------------------------
# Create a GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
# with callback <your-site-url>/api/auth/callback, then set these. Only
# OWNER_GITHUB_LOGIN may sign in; everyone else gets the sign-in screen.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
OWNER_GITHUB_LOGIN=jaykk99
# Server-side GitHub token for the agent's github_api tool (the owner's
# own token; used only by that tool, never sent to the browser).
GITHUB_TOKEN=

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_TOKEN=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
HF_TOKEN=
GRATISFY_API_KEY=
GRATISFY_BASE_URL=https://api.gratisfy.xyz/v1
AIHORDE_API_KEY=

# cfd's own OmniRoute gateway. Off unless both are set — no default base URL
# is guessed, since it's self-hosted and pointing at the wrong host would
# fail silently.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=

# Anthropic — the "heavy tier" model for work that actually needs to be smart.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Shown in the install command on the landing page
NEXT_PUBLIC_SITE_URL=https://termux-code.vercel.app
